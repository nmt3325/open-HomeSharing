# systemd *user* unit for homeshare-linux.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp systemd/homeshare.service ~/.config/systemd/user/
#   # edit the paths/flags below to match your checkout and music folder
#   systemctl --user daemon-reload
#   systemctl --user enable --now homeshare.service
#   loginctl enable-linger "$USER"      # keep it running without an active login
#
# Logs:   journalctl --user -u homeshare.service -f
# Reload: systemctl --user reload homeshare.service   (rescans the library)
#
# This runs as your user, needs no root, and talks to the system avahi-daemon
# over D-Bus for mDNS. %h expands to your home directory.

[Unit]
Description=homeshare-linux - iTunes Home Sharing server
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/homeshare-linux
ExecStart=%h/homeshare-linux/.venv/bin/python -u -m homeshare.server \
    --music %h/Music \
    --name "My Linux Library" \
    --learn
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
